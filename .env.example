# Frontend environment configuration.
#
# Preview mode (default): no base URL is set, every domain is served by the
# in-browser mock services. Nothing is sent over the network.
#
# Backend mode: point the app at the NestJS API in ../backend and set
# VITE_DATA_SOURCE=http. Auth, profile, restaurants, menus, checkout, orders,
# deliveries, drivers, promotions and tracking then use the API. Only the
# admin dashboard and restaurant analytics stay on local preview fixtures.

VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=15000

# "mock" | "http" — when omitted, "http" is used only if a base URL exists.
VITE_DATA_SOURCE=mock

# Map integration boundary. The app renders a real Leaflet + OpenStreetMap map
# from backend route geometry whenever live tracking is on and API data is used.
# "preview" keeps the labelled illustration for mock/demo data.
VITE_MAP_PROVIDER=preview
VITE_MAP_TOKEN=

# Live Socket.IO tracking. Enabled by default in HTTP mode; set to "false" to
# fall back to polling tracking snapshots over HTTP only.
VITE_LIVE_TRACKING=true

# Local backend quick start:
#   1. cd backend && cp .env.example .env
#   2. set MONGODB_URI (local or MongoDB Atlas) and JWT_ACCESS_SECRET
#   3. npm install && npm run start:dev
#   4. For another device on your LAN, replace <COMPUTER_LAN_IP> with the
#      computer's IPv4 address and restart Vite:
# VITE_API_BASE_URL=http://<COMPUTER_LAN_IP>:3000/api/v1
# VITE_DATA_SOURCE=http
# The same origin is used for authenticated Socket.IO tracking. Mobile GPS
# requires HTTPS; use an HTTPS reverse proxy or a trusted development tunnel.
# Add the HTTPS frontend origin to backend CORS_ORIGINS.
# VITE_API_BASE_URL=http://localhost:3000/api/v1
# VITE_DATA_SOURCE=http
