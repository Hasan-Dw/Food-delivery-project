# Frontend environment configuration.
#
# Preview mode (default): no base URL is set, every domain is served by the
# in-browser mock services. Nothing is sent over the network.
#
# Backend mode: point the app at the NestJS API in ../backend and set
# VITE_DATA_SOURCE=http. Auth, profile, restaurants, menus, checkout, orders,
# deliveries, drivers, promotions and tracking then use the API. Only the
# admin dashboard and restaurant analytics stay on local preview fixtures.

VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=15000

# "mock" | "http" — when omitted, "http" is used only if a base URL exists.
VITE_DATA_SOURCE=mock

# Map integration boundary (no provider is wired yet).
# "preview" renders the labelled illustration. "google" | "mapbox" require a token.
VITE_MAP_PROVIDER=preview
VITE_MAP_TOKEN=

# Local backend quick start:
#   1. cd backend && cp .env.example .env
#   2. set MONGODB_URI (local or MongoDB Atlas) and JWT_ACCESS_SECRET
#   3. npm install && npm run start:dev
#   4. set the following in this file (or .env.local) and restart Vite
# VITE_API_BASE_URL=http://localhost:3000/api/v1
# VITE_DATA_SOURCE=http
