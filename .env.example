# Frontend-only environment configuration.
# Leave VITE_API_BASE_URL empty to run against the isolated mock services.

VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=15000

# "mock" | "http" — when omitted, "http" is used only if a base URL exists.
VITE_DATA_SOURCE=mock

# Map integration boundary (no provider is wired yet).
# "demo" renders the labelled demo map. "google" | "mapbox" require a token.
VITE_MAP_PROVIDER=demo
VITE_MAP_TOKEN=
