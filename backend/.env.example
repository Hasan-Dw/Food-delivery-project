# Savora API configuration. Copy to backend/.env and replace every value.
NODE_ENV=development
PORT=3000

# MongoDB connection string. Never commit real credentials.
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/savora
# MongoDB Atlas (shared team database). Replace <db_password> with the
# URL-encoded password for the Atlas database user. Keep the database name
# `savora` before the query string.
# MONGODB_URI=mongodb+srv://hasanlaptop2003_db_user:<db_password>@savora-cluster.p1fm9sm.mongodb.net/savora?retryWrites=true&w=majority&appName=savora-cluster

# Use a long random value (for example: openssl rand -hex 48).
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional development seed password. Only the seed script reads this value.
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_DRIVER_PASSWORD=

# Bootstrap admin identity. The seed script creates this account idempotently;
# admin is never selectable through public registration. Leave the defaults for
# local development, set real values for shared/production environments.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# Cloudinary image storage (restaurant covers/logos, menu items, avatars).
# Create a free account at https://cloudinary.com and copy the credentials from
# the dashboard. When these are empty, image endpoints return 503 and the rest
# of the API keeps working. Never expose the secret to the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional top-level folder for every uploaded asset. Defaults to "savora".
CLOUDINARY_FOLDER=

# Road routing and ETA. The defaults use the public OSRM demo server, which
# needs no API key. Point ROUTING_BASE_URL at your own OSRM instance for
# production traffic, or disable it to use the labelled straight-line fallback.
ROUTING_ENABLED=true
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=4000
ROUTING_CACHE_TTL_MS=60000

# Live Socket.IO tracking and driver GPS freshness.
LIVE_TRACKING_ENABLED=true
DRIVER_LOCATION_MAX_AGE_MINUTES=10
